# Copy to backend/.env and fill in values.

# Supabase Postgres connection string
# Dashboard → Project Settings → Database → Connection string (URI)
# Prefer pooler port 6543 (transaction mode)
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Admin page password (/admin)
ADMIN_PASSWORD=change-me
ADMIN_SECRET=long-random-secret-for-session

# Local bind (Render sets PORT automatically — leave CHECKER_HOST as 0.0.0.0)
CHECKER_HOST=0.0.0.0
CHECKER_PORT=5050

# Batch check — keep low so user APIs stay responsive during large phiếu.
# CHECK_WORKERS: parallel Netflix requests inside the batch process (default 3)
# CHECK_WORKERS_MAX: hard cap even if admin requests more (default 4)
# Keep workers LOW on Render free (1 CPU). Higher = user API slower during check.
CHECK_WORKERS=2
CHECK_WORKERS_MAX=2
CHECK_TIMEOUT=10
# Pause between cookies (ms) so API can use CPU — raise if user API still laggy.
CHECK_YIELD_MS=150
# 1 = run batch in a separate OS process (recommended). 0 = thread in API process.
CHECK_USE_PROCESS=1
# Max cookies per POST .../items chunk (FE uses 100).
CHECK_UPLOAD_CHUNK=150
# PENDING rows loaded per page while checking (keeps RAM flat for 2k+).
CHECK_PAGE_SIZE=40
# Cache public /api/live-accounts (seconds)
USER_LIVE_CACHE_TTL=20

# DB pools SEPARATE. Worker pool must stay small (Supabase connection budget).
DB_POOL_API=6
DB_POOL_WORKER=2

# Production: set to your frontend origin(s), comma-separated
# e.g. https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=*
